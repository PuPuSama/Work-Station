LLM_API_KEY=
LLM_MODEL=gpt-5.6-sol
LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY is also accepted as a fallback.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=1536
TAVILY_API_KEY=
APP_PASSWORD=
# Optional. If omitted, APP_PASSWORD is also used to sign sessions.
APP_SESSION_SECRET=
# Set to true when the app is served over HTTPS.
APP_COOKIE_SECURE=false
# Formal multi-user mode remains fail-closed until every M7 cutover capability
# is implemented. This secret is independent from the legacy local session.
ARTICLE_AGENT_SERVER_MODE=false
ARTICLE_AGENT_SERVER_SESSION_SECRET=

KNOWLEDGE_AGENT_ENABLED=false

# Local PostgreSQL/pgvector development service (compose.dev.yaml).
ARTICLE_DB_NAME=article_agent
ARTICLE_DB_USER=article_agent
ARTICLE_DB_PASSWORD=article_agent
ARTICLE_DB_PORT=55433
ARTICLE_AGENT_DATABASE_URL=postgresql+psycopg://article_agent:article_agent@127.0.0.1:55433/article_agent
# Optional M2 override. Defaults beside the configured SQLite data file.
ARTICLE_AGENT_KNOWLEDGE_ROOT=
# Private S3-compatible object storage. Credentials are intentionally separate
# from LLM and Embedding keys. The local compose profile exposes ports on
# localhost only; provide temporary development credentials in your shell.
ARTICLE_AGENT_OBJECT_STORE_BUCKET=article-agent-test-local
ARTICLE_AGENT_OBJECT_STORE_REGION=us-east-1
ARTICLE_AGENT_OBJECT_STORE_ENDPOINT=http://127.0.0.1:59000
ARTICLE_AGENT_OBJECT_STORE_ACCESS_KEY=
ARTICLE_AGENT_OBJECT_STORE_SECRET_KEY=
ARTICLE_AGENT_OBJECT_STORE_FORCE_PATH_STYLE=true
# AES256 is the production default. Use "none" only for a local compatibility
# target that has no KMS/SSE support.
ARTICLE_AGENT_OBJECT_STORE_SSE=AES256
ARTICLE_AGENT_OBJECT_STORE_KMS_KEY_ID=
# Restrict LangGraph checkpoint deserialization to known safe types.
LANGGRAPH_STRICT_MSGPACK=true
