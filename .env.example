# Article Agent Server 配置模板。复制为根目录 .env；不要覆盖已有 .env。
# 完整说明：docs/configuration.md。空密钥表示未配置，请勿填写 replace-me 假密钥。
# 优先级：进程环境 > 根 .env > backend/.env（旧布局回退）。
# 进程设置 ARTICLE_AGENT_ENV_FILE 时，只加载指定文件。
# 不要把真实密钥提交到 Git、前端 NEXT_PUBLIC_*、YAML 或日志。

# 1. 基础运行（必需）
ARTICLE_AGENT_CONFIG=config.yaml
ARTICLE_AGENT_SERVER_MODE=true
ARTICLE_AGENT_SERVER_SESSION_SECRET=
APP_COOKIE_SECURE=true
ARTICLE_AGENT_DATABASE_URL=
# 数据库 URL 格式：postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# Docker Compose 会将 ARTICLE_AGENT_CONFIG 覆盖为 /app/config.docker.yaml。

# 2. 私有对象存储（必需；ENDPOINT 必须可供用户浏览器下载）
ARTICLE_AGENT_OBJECT_STORE_BUCKET=article-agent
ARTICLE_AGENT_OBJECT_STORE_REGION=us-east-1
ARTICLE_AGENT_OBJECT_STORE_ENDPOINT=
# 可选的后端内网地址；留空则后端也使用上面的地址。
ARTICLE_AGENT_OBJECT_STORE_INTERNAL_ENDPOINT=
ARTICLE_AGENT_OBJECT_STORE_ACCESS_KEY=
ARTICLE_AGENT_OBJECT_STORE_SECRET_KEY=
ARTICLE_AGENT_OBJECT_STORE_FORCE_PATH_STYLE=true
# 按存储服务能力选择 AES256 / aws:kms / none；none 不通过严格加密 preflight。
ARTICLE_AGENT_OBJECT_STORE_SSE=AES256
ARTICLE_AGENT_OBJECT_STORE_KMS_KEY_ID=

# 3. 写作大模型（文章生成必需；必须支持 BASE_URL + /responses 的流式响应）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# 模型 ID 为仓库默认示例，必须换成你的网关实际可用且支持 Responses 的模型。
LLM_MODEL=gpt-5.6-sol
LLM_REASONING_EFFORT=medium

# 4. Embedding（知识入库/检索必需；与 LLM 独立，不会回退到 LLM_API_KEY）
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 当前数据库和检索契约固定 1536 维；不能只改此值来换维度。
EMBEDDING_DIMENSIONS=1536

# 5. MinerU（需要 PDF 版面/OCR 解析时配置；DOCX/Excel 使用本地解析）
ARTICLE_AGENT_MINERU_API_KEY=
# 填服务根地址，不要追加 /api/v4。
ARTICLE_AGENT_MINERU_BASE_URL=https://mineru.net
ARTICLE_AGENT_MINERU_MODEL_VERSION=vlm
ARTICLE_AGENT_MINERU_LANGUAGE=en
ARTICLE_AGENT_MINERU_TIMEOUT_SECONDS=300
ARTICLE_AGENT_MINERU_POLL_INTERVAL_SECONDS=3

# 6. 联网搜索 / 自动 AI 率检测（使用相应功能时必需）
TAVILY_API_KEY=
ARTICLE_AGENT_ZEROGPT_API_KEY=
ARTICLE_AGENT_ZEROGPT_BASE_URL=https://api.zerogpt.com

# 7. WordPress（使用项目设置中的账号保存/上传时必需）
# 独立、稳定、至少 32 字符；丢失后无法解密已保存的 Application Password。
ARTICLE_AGENT_WORDPRESS_CREDENTIALS_KEY=
# 推荐每个项目在界面设置站点与账号。以下是可选全局回退，通常留空。
ARTICLE_AGENT_WORDPRESS_URL=
ARTICLE_AGENT_WORDPRESS_USERNAME=
ARTICLE_AGENT_WORDPRESS_APP_PASSWORD=
# 可选项目环境变量引用映射，详见配置指南；不在 JSON 里直接填密码。
# ARTICLE_AGENT_WORDPRESS_PROJECT_CREDENTIALS={"project-id":{"username_env":"WP_PROJECT_USER","app_password_env":"WP_PROJECT_PASSWORD"}}

# 8. 功能开关（准备好服务后按需开启；false 会覆盖 Docker YAML 中的 true）
KNOWLEDGE_AGENT_ENABLED=false
WORKFLOW_ASSISTANT_ENABLED=false
WORKFLOW_ASSISTANT_ATTACHMENTS_ENABLED=false
WORKFLOW_ASSISTANT_PROJECT_CHANGES_ENABLED=false
WORKFLOW_ASSISTANT_GAP_FILL_ENABLED=false
LANGGRAPH_STRICT_MSGPACK=true

# 9. 并发与数据库连接池（先保持基线；不是供应商请求次数保证）
ARTICLE_AGENT_GLOBAL_JOB_CONCURRENCY=8
ARTICLE_AGENT_PROJECT_JOB_CONCURRENCY=5
WORKFLOW_ASSISTANT_MAX_CONCURRENCY=5
ARTICLE_AGENT_DB_POOL_SIZE=20
ARTICLE_AGENT_DB_MAX_OVERFLOW=20
ARTICLE_AGENT_DB_POOL_TIMEOUT_SECONDS=60
ARTICLE_AGENT_DB_POOL_RECYCLE_SECONDS=300

# 10. 已有组织账号的一次性密码引导（正常数据库账号登录不要求填写）
# 不会创建组织/用户；数据库已有密码哈希时，环境密码不再覆盖它。
# ARTICLE_AGENT_LOGIN_USERNAME=
# ARTICLE_AGENT_LOGIN_PASSWORD=
# ARTICLE_AGENT_LOGIN_ORGANIZATION_ID=
# ARTICLE_AGENT_LOGIN_USER_ID=
# ARTICLE_AGENT_LOGIN_SESSION_SECONDS=43200

# 11. 本机正常 Server Compose 可选项（不用免登录脚本时才需要）
# ARTICLE_DB_USER=article_agent
# ARTICLE_DB_PASSWORD=
# ARTICLE_DB_NAME=article_agent
# ARTICLE_DB_PORT=55433
# ARTICLE_OBJECT_STORE_API_PORT=59000
# ARTICLE_OBJECT_STORE_CONSOLE_PORT=59001

# 12. 前端独立运行时设置在 frontend 的进程环境，Docker 构建有自己的默认值。
# NEXT_PUBLIC_API_BASE_URL=
# ARTICLE_AGENT_API_PROXY_TARGET=http://127.0.0.1:8000
# 根 .env 不会自动成为 Next.js 的 frontend/.env。
# ARTICLE_AGENT_ROOT 和 ARTICLE_AGENT_KNOWLEDGE_ROOT 通常不需要手动配置。
