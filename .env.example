LLM_API_KEY=
LLM_MODEL=gpt-5.6-sol
LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY is also accepted as a fallback.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=1536
TAVILY_API_KEY=
APP_PASSWORD=
# Optional. If omitted, APP_PASSWORD is also used to sign sessions.
APP_SESSION_SECRET=
# Set to true when the app is served over HTTPS.
APP_COOKIE_SECURE=false

KNOWLEDGE_AGENT_ENABLED=false

# Local PostgreSQL/pgvector development service (compose.dev.yaml).
ARTICLE_DB_NAME=article_agent
ARTICLE_DB_USER=article_agent
ARTICLE_DB_PASSWORD=article_agent
ARTICLE_DB_PORT=55433
ARTICLE_AGENT_DATABASE_URL=postgresql+psycopg://article_agent:article_agent@127.0.0.1:55433/article_agent
# Optional M2 override. Defaults beside the configured SQLite data file.
ARTICLE_AGENT_KNOWLEDGE_ROOT=
