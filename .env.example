# Article Agent environment template
# Copy this file to the repository root as .env and fill in the real values.
# Never commit .env or paste its values into logs, YAML, or issue reports.
#
# Default precedence:
#   process environment > root .env > backend/.env (legacy fallback)
# If ARTICLE_AGENT_ENV_FILE is set in the process environment, only that file
# is loaded: process environment > selected file.
# The root .env is the only recommended project environment file.

# Runtime/bootstrap
# Set ARTICLE_AGENT_ENV_FILE in the shell/launcher when selecting another file.
ARTICLE_AGENT_ROOT=
ARTICLE_AGENT_CONFIG=config.yaml
ARTICLE_AGENT_SERVER_MODE=true
ARTICLE_AGENT_BACKEND_HOST=127.0.0.1
ARTICLE_AGENT_BACKEND_PORT=8000
APP_COOKIE_SECURE=true

# PostgreSQL and server session
ARTICLE_AGENT_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/article_agent
ARTICLE_AGENT_SERVER_SESSION_SECRET=replace-with-a-long-random-value
ARTICLE_AGENT_DB_POOL_SIZE=20
ARTICLE_AGENT_DB_MAX_OVERFLOW=20
ARTICLE_AGENT_DB_POOL_TIMEOUT_SECONDS=60
ARTICLE_AGENT_DB_POOL_RECYCLE_SECONDS=300

# OIDC
ARTICLE_AGENT_OIDC_ISSUER=https://identity.example.com/
ARTICLE_AGENT_OIDC_CLIENT_ID=replace-me
ARTICLE_AGENT_OIDC_CLIENT_SECRET=replace-me
ARTICLE_AGENT_OIDC_REDIRECT_URI=https://app.example.com/api/auth/oidc/callback
ARTICLE_AGENT_OIDC_POST_LOGIN_ORIGIN=https://app.example.com
ARTICLE_AGENT_OIDC_POST_LOGIN_PATH=/

# Private object storage
ARTICLE_AGENT_OBJECT_STORE_BUCKET=article-agent
ARTICLE_AGENT_OBJECT_STORE_REGION=us-east-1
ARTICLE_AGENT_OBJECT_STORE_ENDPOINT=https://objects.example.com
ARTICLE_AGENT_OBJECT_STORE_INTERNAL_ENDPOINT=
ARTICLE_AGENT_OBJECT_STORE_ACCESS_KEY=replace-me
ARTICLE_AGENT_OBJECT_STORE_SECRET_KEY=replace-me
ARTICLE_AGENT_OBJECT_STORE_FORCE_PATH_STYLE=true
ARTICLE_AGENT_OBJECT_STORE_SSE=none
ARTICLE_AGENT_OBJECT_STORE_KMS_KEY_ID=

# LLM and embedding providers
LLM_API_KEY=replace-me
# OPENAI_API_KEY=replace-me  # legacy LLM key fallback
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-sol
LLM_REASONING_EFFORT=medium
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional integrations
TAVILY_API_KEY=replace-me
ARTICLE_AGENT_ZEROGPT_API_KEY=replace-me
# ZEROGPT_API_KEY=replace-me  # legacy ZeroGPT key fallback
ARTICLE_AGENT_ZEROGPT_BASE_URL=https://api.zerogpt.com
ARTICLE_AGENT_MINERU_API_KEY=replace-me
ARTICLE_AGENT_MINERU_BASE_URL=https://mineru.net
ARTICLE_AGENT_MINERU_MODEL_VERSION=vlm
ARTICLE_AGENT_MINERU_LANGUAGE=en
ARTICLE_AGENT_MINERU_TIMEOUT_SECONDS=120
ARTICLE_AGENT_MINERU_POLL_INTERVAL_SECONDS=2
ARTICLE_AGENT_KNOWLEDGE_ROOT=

# Feature switches. Keep the master switch and sub-switches explicit.
KNOWLEDGE_AGENT_ENABLED=false
WORKFLOW_ASSISTANT_ENABLED=false
WORKFLOW_ASSISTANT_ATTACHMENTS_ENABLED=false
WORKFLOW_ASSISTANT_PROJECT_CHANGES_ENABLED=false
WORKFLOW_ASSISTANT_GAP_FILL_ENABLED=false
LANGGRAPH_STRICT_MSGPACK=true

# Frontend build/proxy settings, when running the frontend outside Compose.
NEXT_PUBLIC_API_BASE_URL=
ARTICLE_AGENT_API_PROXY_TARGET=http://127.0.0.1:8000

# Legacy portable-mode compatibility only; Server mode does not use these.
# APP_PASSWORD=
# APP_SESSION_SECRET=
